{
  "manifest_version": 3,
  "name": "拾页 · Pagefold",
  "version": "0.4.2",
  "description": "按项目整理标签页，保留每次浏览的有序路径。AI 分析、自定义标签、可恢复整理。",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "idle",
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开拾页"
  },
  "side_panel": {
    "default_path": "index.html?panel=1"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "打开拾页工作台"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "incognito": "not_allowed",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": "",
  "optional_permissions": [
    "history"
  ]
}
